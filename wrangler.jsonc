{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"lottery-sambad","main":"src/worker.mjs",
 "compatibility_date":"2026-10-04","compatibility_flags":["nodejs_compat"],
 "assets":{"directory":"./public","binding":"ASSETS","run_worker_first":true},
 "browser":{"binding":"BROWSER"},
 "r2_buckets":[{"binding":"RESULTS","bucket_name":"lottery-sambad-results"}],
 "durable_objects":{"bindings":[{"name":"UPDATER","class_name":"ResultUpdater"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["ResultUpdater"]}],
 "triggers":{"crons":["40 7,12,14 * * *","40 8,9,10,11,13,15,16,17 * * *"]},"observability":{"enabled":true}
}
